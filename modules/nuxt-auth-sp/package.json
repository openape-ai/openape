{
  "name": "@openape/nuxt-auth-sp",
  "type": "module",
  "version": "0.15.2",
  "turbo": {
    "tags": [
      "publishable"
    ]
  },
  "description": "OpenApe Service Provider Nuxt module \u2014 adds OIDC login via DNS-based IdP discovery",
  "author": "Delta Mind GmbH",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./handlers": {
      "types": "./dist/runtime/server/handlers.d.ts",
      "import": "./dist/runtime/server/handlers.js"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:stubs": "find src/runtime \\( -name '*.d.ts' -o -name '*.d.vue.ts' -o -name '*.js' \\) -delete 2>/dev/null; true",
    "prepack": "nuxt-module-build build",
    "prebuild": "pnpm clean:stubs",
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub",
    "prepare": "nuxt-module-build build --stub && nuxi prepare playground",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:layout": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@openape/auth": "workspace:*",
    "@openape/core": "workspace:*",
    "defu": "catalog:",
    "jose": "catalog:"
  },
  "peerDependencies": {
    "h3": "^1.15.11",
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "@nuxt/ui": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/test-utils": "catalog:",
    "h3": "catalog:",
    "nuxt": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openape-ai/openape.git",
    "directory": "modules/nuxt-auth-sp"
  }
}
