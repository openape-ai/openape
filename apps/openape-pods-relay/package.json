{
  "name": "@openape-pods-relay/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop registration, central workspace and inbox for OpenApe Pods",
  "scripts": {
    "dev": "nuxt dev --port 3028",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "nuxt prepare",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@openape/auth": "workspace:*",
    "@openape/core": "workspace:*",
    "@openape/pods-protocol": "workspace:*",
    "h3": "catalog:",
    "jose": "catalog:",
    "nuxt": "catalog:",
    "@openape/nuxt-auth-sp": "workspace:*",
    "vue": "catalog:",
    "web-push": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/web-push": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "openape-e2e": "workspace:*",
    "@openape/pods": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "playwright": "catalog:"
  }
}
