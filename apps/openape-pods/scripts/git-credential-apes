#!/bin/sh
# APES_AUTH_FILE selects the managed Pod identity; ordinary host Git uses apes login.
set -eu
[ "${1-}" = get ] || exit 0
protocol=''
host=''
while IFS= read -r line; do
  [ -n "$line" ] || break
  case "$line" in
    protocol=*) [ -z "$protocol" ] || exit 0; protocol=${line#protocol=} ;;
    host=*) [ -z "$host" ] || exit 0; host=${line#host=} ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = repos.openape.ai ] || exit 0
auth_file=${APES_AUTH_FILE-"$HOME/.config/apes/auth.json"}
[ -n "$auth_file" ] || exit 1
token=$(jq -er '.access_token | select(type == "string" and length > 0 and (test("[\\r\\n]") | not))' "$auth_file")
printf 'username=x-access-token\npassword=%s\n' "$token"
