#!/bin/sh
# APES_AUTH_FILE selects the managed Pod identity; ordinary host Git uses apes login.
set -eu
[ "${1-}" = get ] || exit 0
auth_file=${APES_AUTH_FILE:-"$HOME/.config/apes/auth.json"}
token=$(jq -er '.access_token | select(type == "string" and length > 0)' "$auth_file")
printf 'username=x-access-token\npassword=%s\n' "$token"
