{
  "name": "@openape/pods",
  "version": "0.1.3",
  "private": true,
  "description": "OpenApe Pods desktop workspace",
  "author": "OpenApe",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/app.cjs",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm package:mac && vitest run --config vitest.electron.config.ts --reporter=default --reporter=json --outputFile.json=.artifacts/electron-tests.json",
    "test:boundaries": "vitest run --config vitest.electron.config.ts -t boundary",
    "package:mac": "node scripts/package.mjs",
    "test:packaged": "vitest run --config vitest.electron.config.ts -t packaged",
    "test:layout": "pnpm test:browser",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:fast": "vitest run && vitest run --config vitest.browser.config.ts",
    "report": "node scripts/report.mjs",
    "package:distribution": "node scripts/package.mjs --distribution",
    "package:signed": "node scripts/package.mjs --distribution --signed",
    "package:signed-candidate": "node scripts/package.mjs --distribution --signed-candidate",
    "package:owner": "node scripts/package.mjs --distribution --owner",
    "install:owner": "node scripts/install-owner.mjs",
    "test:distribution": "node scripts/verify-distribution.mjs",
    "handbook": "node scripts/handbook.mjs",
    "handbook:capture": "PODS_HANDBOOK_CAPTURE=1 vitest run --config vitest.electron.config.ts",
    "dev:ui": "vite --mode ui",
    "build:runtime": "node scripts/build-runtime.mjs",
    "cli": "node dist/cli/entry.cjs"
  },
  "dependencies": {
    "croner": "10.0.1",
    "electron-updater": "6.6.2",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@openai/codex": "0.153.4",
    "@openai/codex-sdk": "0.153.4",
    "@openape/apes": "workspace:*",
    "@openape/cli-auth": "workspace:*",
    "@openape/core": "workspace:*",
    "@openape/grants": "workspace:*",
    "@openape/pods-protocol": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/test-utils": "catalog:",
    "electron": "40.9.3",
    "electron-builder": "26.15.3",
    "eslint": "catalog:",
    "fflate": "0.8.3",
    "happy-dom": "catalog:",
    "npm": "11.19.1",
    "playwright": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "8.2.1",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "bin": {
    "ape-pods": "dist/cli/entry.cjs"
  }
}
