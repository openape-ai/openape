{
  "name": "@openape/ape-secrets",
  "version": "0.1.1",
  "description": "CLI for secrets.openape.ai — hand a secret to a machine without it passing through a chat",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ape-secrets": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@openape/cli-auth": "workspace:*",
    "@openape/proof-cli": "workspace:*",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    "./vault": {
      "types": "./dist/vault-crypto.d.ts",
      "import": "./dist/vault-crypto.mjs"
    }
  }
}
