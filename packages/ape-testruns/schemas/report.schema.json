{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openape:report-template-contract:1",
  "title": "OpenApe report template input",
  "description": "Versioned report input. Semantic validation and evidence resolution are mandatory; see RENDERING.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/testRun"
    },
    {
      "$ref": "#/$defs/plan"
    }
  ],
  "$defs": {
    "link": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "placement": {
          "enum": [
            "before-details",
            "after-details"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "source",
            "build",
            "deployment",
            "device",
            "prototype",
            "other"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "changesDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "additionalProperties": false
    },
    "inspection": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "enum": [
            "matches",
            "differs",
            "inconclusive"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "by",
        "at",
        "result",
        "notes",
        "digest"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "kind": {
          "const": "image"
        },
        "role": {
          "enum": [
            "evidence",
            "reference",
            "mockup"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000-\\u001f]+$"
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "theme": {
          "enum": [
            "light",
            "dark",
            "other"
          ]
        },
        "inspection": {
          "$ref": "#/$defs/inspection"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "role",
        "path",
        "caption"
      ],
      "additionalProperties": false
    },
    "textEvidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "kind": {
          "const": "text"
        },
        "role": {
          "enum": [
            "evidence",
            "reference"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000-\\u001f]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "\\S"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "role"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {}
            }
          },
          "properties": {
            "path": {}
          }
        },
        {
          "required": [
            "text"
          ],
          "not": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {}
            }
          },
          "properties": {
            "text": {}
          }
        }
      ]
    },
    "linkEvidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "kind": {
          "const": "link"
        },
        "role": {
          "enum": [
            "evidence",
            "reference",
            "mockup"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "role",
        "url"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/textEvidence"
        },
        {
          "$ref": "#/$defs/linkEvidence"
        }
      ]
    },
    "command": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "outcome": {
          "enum": [
            "exited",
            "timed-out",
            "interrupted",
            "not-started"
          ]
        },
        "exitCode": {
          "type": "integer"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expectedExitCodes": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        }
      },
      "required": [
        "id",
        "command",
        "outcome"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "exited"
              }
            }
          },
          "then": {
            "required": [
              "exitCode"
            ],
            "properties": {
              "exitCode": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "exitCode"
              ],
              "properties": {
                "exitCode": {}
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "blocked"
          ]
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        },
        "commandIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "blocked"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "observed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "commandIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "id",
        "title",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "skipped",
                  "blocked"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {}
            }
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "acceptable",
            "action-required",
            "inconclusive",
            "not-assessed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        }
      },
      "required": [
        "outcome",
        "summary"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "url",
        "format"
      ],
      "additionalProperties": false
    },
    "testRun": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{1,8})*$"
        },
        "sample": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "schema": {
          "const": "openape.test-run/1"
        },
        "purpose": {
          "enum": [
            "verification",
            "characterization",
            "reference"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "series": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "object",
          "properties": {
            "covered": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 200
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 200
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "nextStep": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        }
      },
      "required": [
        "schema",
        "title",
        "purpose",
        "tests"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected"
          ]
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        }
      },
      "required": [
        "title",
        "description",
        "status"
      ],
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "done",
            "blocked"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "proof": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        },
        "rollback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "blocker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
