{
  "name": "@openape/ape-testruns",
  "version": "0.7.0",
  "description": "Publish single-file HTML reports and upload compatible OpenApe test evidence",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ape-testruns": "./dist/cli.mjs",
    "ape-reports": "./dist/reports.mjs",
    "ape-report-render": "./dist/render.mjs"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "REPORTS-CLI.md",
    "RENDERING.md",
    "templates",
    "schemas"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://repos.openape.ai/patrick/monorepo.git",
    "directory": "packages/ape-testruns"
  },
  "homepage": "https://report.openape.ai",
  "bugs": {
    "url": "https://repos.openape.ai/patrick/monorepo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@openape/cli-auth": "workspace:*",
    "@openape/proof-cli": "workspace:*",
    "citty": "^0.1.6",
    "htmlparser2": "10.1.0",
    "postcss": "8.5.25",
    "postcss-value-parser": "4.2.0",
    "marked": "catalog:",
    "sanitize-html": "^2.14.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@openape/report-contracts": "workspace:*",
    "@types/sanitize-html": "^2.13.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "testing",
    "e2e",
    "test-report",
    "openape",
    "cli",
    "agent",
    "ddisa"
  ]
}
