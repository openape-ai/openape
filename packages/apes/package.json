{
  "name": "@openape/apes",
  "version": "1.35.4",
  "turbo": {
    "tags": [
      "publishable"
    ]
  },
  "description": "Unified CLI + MCP Server for OpenApe",
  "type": "module",
  "bin": {
    "apes": "./dist/cli.js",
    "ape-shell": "./scripts/ape-shell-wrapper.sh"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openape/agent-runtime": "workspace:*",
    "@openape/cli-auth": "workspace:*",
    "@openape/core": "workspace:*",
    "@openape/grants": "workspace:*",
    "@openape/proxy": "workspace:*",
    "@openape/shapes": "workspace:*",
    "citty": "^0.2.2",
    "consola": "catalog:",
    "giget": "^2.0.0",
    "shell-quote": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/shell-quote": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "openape-e2e": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "author": "Patrick Hofmann <phofmann@delta-mind.at>",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openape-ai/openape.git",
    "directory": "packages/apes"
  }
}
