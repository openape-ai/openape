{
  "name": "@openape/protocol-conformance",
  "version": "0.0.6",
  "description": "JSON Schemas for the DDISA and OpenApe protocol documents, kept executable by a conformance test suite",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openape-ai/openape.git",
    "directory": "packages/protocol-conformance"
  },
  "exports": {
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "schemas"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sync-schemas": "node ../../scripts/sync-protocol-schemas.mjs"
  },
  "devDependencies": {
    "@openape/core": "workspace:*",
    "@openape/grants": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
