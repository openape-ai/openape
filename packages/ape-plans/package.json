{
  "name": "@openape/ape-plans",
  "version": "1.0.5",
  "description": "CLI for plans.openape.ai — cross-device plan management for humans and AI agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ape-plans": "./dist/cli.mjs"
  },
  "exports": {
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://repos.openape.ai/patrick/monorepo.git",
    "directory": "packages/ape-plans"
  },
  "homepage": "https://plans.openape.ai",
  "bugs": {
    "url": "https://repos.openape.ai/patrick/monorepo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@openape/cli-auth": "workspace:*",
    "@openape/proof-cli": "workspace:*",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "plans",
    "openape",
    "cli",
    "agent",
    "ddisa"
  ]
}
