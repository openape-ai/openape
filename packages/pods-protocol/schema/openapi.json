    "/api/mobile/v1/session/begin": {
      "post": {
        "operationId": "beginEnrollment",
        "responses": {
          "200": {
            "description": "beginEnrollment"
          },
          "default": {
            "description": "RFC 9457 application problem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "deviceId",
                  "kind",
                  "keys",
                  "challenge",
                  "email"
                ],
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "kind": {
                    "enum": [
                      "runtime",
                      "mobile"
                    ]
                  },
                  "keys": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "signing",
                      "agreement"
                    ],
                    "properties": {
                      "signing": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "minLength": 87,
                        "maxLength": 87
                      },
                      "agreement": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "minLength": 87,
                        "maxLength": 87
                      }
                    }
                  },
                  "challenge": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "minLength": 43,
                    "maxLength": 43
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 320
                  }
                }
              }
            }
          }
        }
      }
    },
