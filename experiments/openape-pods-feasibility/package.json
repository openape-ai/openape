{
  "name": "openape-pods-feasibility",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm --dir ../.. exec eslint experiments/openape-pods-feasibility/src",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "build": "../../node_modules/.bin/tsc && xcrun clang -Wall -Wextra -Werror -O2 native/file-probe.c -o dist/file-probe",
    "test:boundaries": "node dist/boundaries.js",
    "test": "node --test dist/profile.test.js",
    "test:helper": "python3 helper_probe.py"
  }
}
