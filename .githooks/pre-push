#!/bin/bash
set -o pipefail
# The canonical repository is shared by release, deploy and local git guards.
# Validate the destination even when expensive checks are skipped.
node "$(git rev-parse --show-toplevel)/scripts/repository.mjs" check-push "$2" || exit 1

if [ -n "$CI" ]; then exit 0; fi
if [ "$SKIP_HOOKS" = "1" ]; then
  echo "[pre-push] SKIP_HOOKS=1 — skipping local CI gate"
  exit 0
fi

# Local pushes run only the affected unit suite (lint, typecheck, unit and
# component tests). E2E and layout run once externally for the pushed head and
# are recorded on the pull request; run `pnpm check:ci` explicitly before deployments.
echo "[pre-push] Running affected unit checks against origin/main"
git fetch --quiet origin main || exit 1
exec pnpm check:affected --base origin/main --head HEAD --suite unit
