{
  "name": "openape",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "node scripts/e2e.mjs",
    "dev": "turbo run dev",
    "graph": "node scripts/workspace-map.mjs",
    "knip": "node scripts/knip-workspaces.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/publish-chain.mjs",
    "release:dry": "node scripts/publish-chain.mjs --dry-run",
    "release:local": "node scripts/release-local.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:image": "node scripts/deploy-image.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "deploy:docs-site": "node scripts/deploy-docs-site.mjs",
    "guides": "bash compose/demo/run.sh",
    "repo:status": "node scripts/repository.mjs",
    "check:affected": "node scripts/check.mjs affected",
    "check:ci": "node scripts/check.mjs ci",
    "docs:check": "node scripts/workspace-map.mjs --check",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "catalog:",
    "@libsql/client": "^0.17.4",
    "@vitest/coverage-istanbul": "^4.1.12",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "knip": "^6.45.1",
    "nostics": "1.2.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11"
  }
}
